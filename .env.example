# ---- Firebase web app config (Firebase console → Project settings → Your apps) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Must match REGION in functions/src/lib/app.ts (default europe-west1)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# App Check (reCAPTCHA Enterprise site key). Leave empty in local development.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Canonical site URL used for SEO (sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that Cloud Functions send to /api/revalidate (any long random string).
# Must match functions/.secret.local when using the emulators.
REVALIDATE_SECRET=local-dev-secret

# ---- Local development against the Firebase Emulator Suite ----
# Set to "true" to point the browser SDK at the emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Used by the server-side Admin SDK (storefront data reads) when running emulators.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# With emulators any project id works; use the demo- prefix so nothing touches production.
GCLOUD_PROJECT=demo-stryke

# ---- Production server credentials ----
# On Firebase App Hosting the server authenticates automatically (no key needed).
# Elsewhere, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
# Never commit service-account keys.
