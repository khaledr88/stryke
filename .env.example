# ---------------------------------------------------------------------------
# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public by design; security comes from Firestore rules.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical site URL used for SEO (sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# The whole Firebase service-account key JSON, on one line
# (Firebase console → Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Product photos (Vercel Blob). On Vercel, connecting a Blob store to the project adds
# BLOB_STORE_ID (and BLOB_WEBHOOK_PUBLIC_KEY) and signs in with Vercel OIDC — nothing to copy.
# For uploads from your own computer, run `vercel env pull` (it brings BLOB_STORE_ID and a
# temporary VERCEL_OIDC_TOKEN), or set an older-style BLOB_READ_WRITE_TOKEN instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Any long random string. Lets trusted callers refresh the storefront cache.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Any long random string. Vercel Cron sends it to /api/cron/purge.
CRON_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Optional: App Check (reCAPTCHA v3, free) to block bots at checkout
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Set to true only after App Check shows verified requests in the Firebase console.
ENFORCE_APP_CHECK=false

# ---------------------------------------------------------------------------
# Local development with the Firebase emulators (leave unset on Vercel)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GCLOUD_PROJECT=demo-stryke
